<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Aura</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="15.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="aura"/>
    </choices-outline>
    <choice id="aura" visible="false" title="Aura">
        <pkg-ref id="com.aura.wallpapers.pkg"/>
    </choice>
    <pkg-ref id="com.aura.wallpapers.pkg" version="__VERSION__" onConclusion="none">Aura-component.pkg</pkg-ref>
</installer-gui-script>
